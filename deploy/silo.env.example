# Copier ce fichier vers /etc/silo/silo.env et l'adapter.
# Voir README.md pour la description de chaque variable.

SILO_LISTEN_ADDR=127.0.0.1:8080
SILO_DATA_DIR=/var/lib/silo

# Racines de partage exposées par l'explorateur de fichiers :
# "nom=chemin,nom2=chemin2"
SILO_SHARE_ROOTS=pool=/mnt/pool

# true en production derrière HTTPS (reverse proxy). Mettre à false
# uniquement pour un accès HTTP direct en développement.
SILO_COOKIE_SECURE=true

SILO_SESSION_TTL_HOURS=168

# Laisser vide pour utiliser le socket Docker par défaut.
SILO_DOCKER_HOST=
