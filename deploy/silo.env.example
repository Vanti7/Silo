# Copier ce fichier vers /etc/silo/silo.env et l'adapter.
# Voir README.md pour la description de chaque variable.

# ":8080" écoute sur toutes les interfaces (accessible depuis le LAN).
# Pour restreindre à la machine locale uniquement (ex: derrière un reverse
# proxy HTTPS), utiliser "127.0.0.1:8080" à la place.
SILO_LISTEN_ADDR=:8080
SILO_DATA_DIR=/var/lib/silo

# Racines de partage exposées par l'explorateur de fichiers :
# "nom=chemin,nom2=chemin2"
SILO_SHARE_ROOTS=pool=/mnt/pool

# Le cookie de session porte l'attribut Secure quand true : le navigateur
# refuse alors de l'envoyer hors HTTPS. Laisser à false pour un accès
# direct en HTTP sur le LAN (cas par défaut ci-dessus). Ne passer à true
# que si silo est exposé derrière un reverse proxy HTTPS.
SILO_COOKIE_SECURE=false

SILO_SESSION_TTL_HOURS=168

# Laisser vide pour utiliser le socket Docker par défaut.
SILO_DOCKER_HOST=
